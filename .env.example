# ========== قاعدة البيانات ==========
# 8 حروف على الأقل، فيها حرف كبير وصغير ورقم أو رمز.
# متستخدمش الرموز دي: $  ;  "  '  =
SA_PASSWORD=FixFlow-Sql-2026-ChangeMe

# ========== الأمان ==========
# مفتاح عشوائي طويل (32+ حرف). طريقة توليده في الخطوات.
JWT_KEY=CHANGE_ME_generate_a_random_key_with_the_command_in_the_guide

# حساب الأدمن اللي بيتعمل أول تشغيل
ADMIN_EMAIL=admin@fixflow.com
ADMIN_PASSWORD=Admin-ChangeMe-2026

# ========== العنوان ==========
# لو البورت 80 مشغول عندك، خليه 8080 وغيّر PUBLIC_URL لـ http://localhost:8080
WEB_PORT=80
PUBLIC_URL=http://localhost

# Swagger على http://localhost:5080/swagger (للتطوير. في السيرفر خليه false)
SWAGGER_ENABLED=true

# ========== Webhook (اختياري) ==========
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=change-me-webhook-secret

# ========== للسيرفر فقط (الجزء الاختياري في آخر المرحلة) ==========
# IMAGE_OWNER=awed-karim
# DOMAIN=:80